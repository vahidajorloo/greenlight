<% ui_rtl = %w[fa ar he ur ps ckb ug dv yi].include?(I18n.default_locale.to_s.split(/[-_]/).first) -%>
<!DOCTYPE html>
<html lang="<%= I18n.default_locale.to_s.tr('_', '-') %>" dir="<%= ui_rtl ? 'rtl' : 'ltr' %>" data-default-locale="<%= I18n.default_locale %>">
  <head>
    <title>تهران سرور</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- Open Graph Attributes -->
    <meta property="og:title" content="<%= page_title %>" />
    <meta property="og:description" content="<%= t('opengraph.description') %>" />
    <meta property="og:image" content="<%= branding_image %>" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", id: "css-ltr", media: (ui_rtl ? "not all" : "all") %>
    <%= stylesheet_link_tag "application.rtl", id: "css-rtl", media: (ui_rtl ? "all" : "not all") %>
    <%= javascript_include_tag "main", defer: true %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>

